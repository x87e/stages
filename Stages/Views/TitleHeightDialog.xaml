<!--
  TitleHeightDialog.xaml
  Slider for a Stage's title bar height (port of NoFences' HeightDialog).
  Slider limits are set from StageDefaults in the code-behind, not here.
  Light or dark to match Settings > Appearance > Theme.
-->
<Window x:Class="TitleHeightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change title height"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemePrimaryTextBrush}">
    <!-- Shared styles; colours come from the theme (Settings > Appearance > Theme) -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Stages;component/Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="12" Width="300">
        <DockPanel>
            <!-- Current value, e.g. "35px" -->
            <TextBlock x:Name="HeightValueText" DockPanel.Dock="Right" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="HeightSlider"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ValueChanged="HeightSlider_ValueChanged" />
        </DockPanel>
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="RestoreDefaultButton" DockPanel.Dock="Left" Content="Restore default"
                    Style="{StaticResource SettingsButtonStyle}" Click="RestoreDefaultButton_Click" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Width="80" IsCancel="True"
                    Style="{StaticResource SettingsButtonStyle}" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True"
                    Style="{StaticResource SettingsButtonStyle}" Click="OkButton_Click" />
        </DockPanel>
    </StackPanel>
</Window>
