<!--
  RenameDialog.xaml
  Small modal window for renaming a Stage (port of NoFences' EditDialog).
  Enter = OK (IsDefault), Esc = Cancel (IsCancel).
  Light or dark to match Settings > Appearance > Theme.
-->
<Window x:Class="RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Stage"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemePrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <!-- Shared styles; colours come from the theme (Settings > Appearance > Theme) -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Stages;component/Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="12" Width="280">
        <TextBlock Text="Name:" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Style="{StaticResource SettingsTextBoxStyle}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True"
                    Style="{StaticResource SettingsButtonStyle}" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True"
                    Style="{StaticResource SettingsButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
