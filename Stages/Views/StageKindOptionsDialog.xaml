<!--
  StageKindOptionsDialog.xaml
  Options for a Live folder, Running tasks or Clipboard history Stage or tab
  (Stage menu > "... options..."). One dialog with three sets of options;
  the code-behind shows only the set for the tab's kind.
  Slider limits come from StageDefaults in the code-behind, not from here.
  Light or dark to match Settings > Appearance > Theme.
-->
<Window x:Class="StageKindOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        Foreground="{DynamicResource ThemePrimaryTextBrush}">
    <!-- Shared styles; colours come from the theme (Settings > Appearance > Theme) -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Stages;component/Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="14">

        <!-- ===== Live folder ===== -->
        <StackPanel x:Name="LiveFolderPanel" Visibility="Collapsed">
            <TextBlock Text="Folder shown" Style="{StaticResource SettingsCardTitleStyle}" />
            <DockPanel Margin="0,0,0,10">
                <Button x:Name="ChangeFolderButton" DockPanel.Dock="Right" Content="Change..."
                        Style="{StaticResource SettingsButtonStyle}" Click="ChangeFolderButton_Click" />
                <TextBlock x:Name="FolderPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
            </DockPanel>

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Sub-folders" Style="{StaticResource SettingsRowLabelStyle}" />
                <Slider x:Name="DepthSlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}" ValueChanged="AnySlider_ValueChanged" />
                <TextBlock x:Name="DepthValueText" Grid.Column="2" Style="{StaticResource SettingsRowValueStyle}" />
            </Grid>
            <CheckBox x:Name="ShowFoldersCheckBox" Content="Show folders as items" Style="{StaticResource SettingsCheckBoxStyle}" />

            <TextBlock Text="Only show files named" Margin="0,10,0,4" Style="{StaticResource SettingsRowLabelStyle}" />
            <TextBox x:Name="LiveIncludeBox" Style="{StaticResource SettingsTextBoxStyle}" />
            <TextBlock Text="Leave out files and folders named" Margin="0,10,0,4" Style="{StaticResource SettingsRowLabelStyle}" />
            <TextBox x:Name="LiveExcludeBox" Style="{StaticResource SettingsTextBoxStyle}" />
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,10"
                       Text="Separate names with ; or , - for example  *.pdf; *.docx  or  report. * stands for any characters and ? for any one character. A name without * or ? matches anything containing it. Leave the first box empty to show every file." />

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Show at most" Style="{StaticResource SettingsRowLabelStyle}" />
                <Slider x:Name="MaximumItemsSlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}" ValueChanged="AnySlider_ValueChanged" />
                <TextBlock x:Name="MaximumItemsValueText" Grid.Column="2" Style="{StaticResource SettingsRowValueStyle}" />
            </Grid>
        </StackPanel>

        <!-- ===== Running tasks ===== -->
        <StackPanel x:Name="RunningTasksPanel" Visibility="Collapsed">
            <TextBlock Text="Which windows" Style="{StaticResource SettingsCardTitleStyle}" />
            <TextBlock Text="Only show windows whose title or program matches" Margin="0,4,0,4" Style="{StaticResource SettingsRowLabelStyle}" />
            <TextBox x:Name="TasksIncludeBox" Style="{StaticResource SettingsTextBoxStyle}" />
            <TextBlock Text="Leave out windows whose title or program matches" Margin="0,10,0,4" Style="{StaticResource SettingsRowLabelStyle}" />
            <TextBox x:Name="TasksExcludeBox" Style="{StaticResource SettingsTextBoxStyle}" />
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,6"
                       Text="Separate names with ; or , - for example  chrome; notepad. The program is its file name without .exe. * and ? work as in Explorer. Leave the first box empty to show every window." />
            <CheckBox x:Name="ShowMinimisedCheckBox" Content="Include minimised windows" Style="{StaticResource SettingsCheckBoxStyle}" />

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Update every" Style="{StaticResource SettingsRowLabelStyle}" />
                <Slider x:Name="IntervalSlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}" ValueChanged="AnySlider_ValueChanged" />
                <TextBlock x:Name="IntervalValueText" Grid.Column="2" Style="{StaticResource SettingsRowValueStyle}" />
            </Grid>
        </StackPanel>

        <!-- ===== Clipboard history ===== -->
        <StackPanel x:Name="ClipboardPanel" Visibility="Collapsed">
            <TextBlock Text="What to keep" Style="{StaticResource SettingsCardTitleStyle}" />
            <CheckBox x:Name="CaptureTextCheckBox" Content="Text" Style="{StaticResource SettingsCheckBoxStyle}" />
            <CheckBox x:Name="CaptureImagesCheckBox" Content="Pictures (saved as .png files)" Style="{StaticResource SettingsCheckBoxStyle}" />
            <CheckBox x:Name="CaptureFilesCheckBox" Content="Copied files and folders (kept as shortcuts to them)" Style="{StaticResource SettingsCheckBoxStyle}" />
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,10"
                       Text="Entries are kept in this Stage's own folder, so they are still there after a restart. Anything a program marks as private - such as a password copied from a password manager - is never kept." />

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Keep at most" Style="{StaticResource SettingsRowLabelStyle}" />
                <Slider x:Name="MaximumEntriesSlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}" ValueChanged="AnySlider_ValueChanged" />
                <TextBlock x:Name="MaximumEntriesValueText" Grid.Column="2" Style="{StaticResource SettingsRowValueStyle}" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Using at most" Style="{StaticResource SettingsRowLabelStyle}" />
                <Slider x:Name="MaximumMegabytesSlider" Grid.Column="1" Style="{StaticResource SettingsSliderStyle}" ValueChanged="AnySlider_ValueChanged" />
                <TextBlock x:Name="MaximumMegabytesValueText" Grid.Column="2" Style="{StaticResource SettingsRowValueStyle}" />
            </Grid>
            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="0,6,0,0"
                       Text="When either limit is reached, the oldest entries are deleted. Lowering a limit applies straight away." />
        </StackPanel>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Width="80" IsCancel="True"
                    Style="{StaticResource SettingsButtonStyle}" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True"
                    Style="{StaticResource SettingsButtonStyle}" Click="OkButton_Click" />
        </DockPanel>
    </StackPanel>
</Window>
