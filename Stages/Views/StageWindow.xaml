<!--
  StageWindow.xaml
  The visual layout of one Stage: a title bar (or tabs) and its items.
  All behaviour lives in StageWindow.xaml.vb and its partial files
  (StageWindow.Layout.vb, StageWindow.Appearance.vb, StageWindow.Tabs.vb).

  Window settings explained:
    WindowStyle=None, Background=Transparent     -> no Windows frame. The window is
                                                   deliberately NOT "layered"
                                                   (no AllowsTransparency): Windows 11
                                                   draws blur on layered windows as solid
                                                   black. Instead the render target is made
                                                   transparent in code and Windows'
                                                   compositor supplies blur/acrylic/
                                                   translucency (works on Windows 10 and 11)
    ResizeMode=NoResize                          -> stops Aero Snap maximising
                                                   the Stage when dragged to an
                                                   edge (resizing is done by our
                                                   own edge hit-testing instead)
    ShowInTaskbar=False / ShowActivated=False    -> behaves like part of the
                                                   desktop, never steals focus
  Note: in VB WPF projects x:Class omits the root namespace ("Stages").
-->
<Window x:Class="StageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Stages"
        Title="Stage"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Stages;component/Themes/StagesStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Background layers, bottom to top. Windows supplies the blur behind them
             (DesktopIntegration.ApplyBackdrop); StageWindow.ApplyBackdropNow chooses which
             of these show for the selected Background, and sets their colours and
             strengths from the app settings (Settings > Appearance). -->

        <!-- Imitation acrylic only: faint white sheen -->
        <Border x:Name="AcrylicLuminosityLayer"
                Visibility="Collapsed" />

        <!-- Whole-Stage tint (black for Blur/Translucent, grey for Acrylic by default) -->
        <Border x:Name="TintLayer" />

        <!-- Imitation acrylic only: fine grain. Not clickable, so it never gets in the way. -->
        <Rectangle x:Name="AcrylicNoiseLayer"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Visibility="Collapsed" />

        <!-- This Stage's own background picture (Background > Picture...), with optional
             blur, and a dark shade over it so labels stay readable. Set up in
             StageWindow.Appearance.vb. -->
        <Image x:Name="BackgroundPicture"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
        <Border x:Name="BackgroundShade"
                Background="Black"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- The Stage's content, top to bottom: the title bar (height set from code), the
             column headings (Details view only), then the items taking the rest. A DockPanel
             rather than rows so the title bar can be docked at the BOTTOM instead while the
             Stage is open upwards (StageWindow.OpenDirection.vb). Being first, the title bar
             always gets its full height, even while the Stage is only title-high. -->
        <DockPanel LastChildFill="True">

            <!-- Title bar: drag it to move the Stage, double-click it to rename the Stage -->
            <!-- The tooltip (after a 1.5 s rest, so it doesn't pop up while just reading the
                 title) tells people about Alt, the "place it freely" key while moving. -->
            <Border x:Name="TitleBar"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource StageTitleBackgroundBrush}"
                    ToolTip="Drag to move. Hold Alt while dragging to place it freely (no snapping)."
                    ToolTipService.InitialShowDelay="1500"
                    ToolTipOpening="TitleBar_ToolTipOpening"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Foreground="{DynamicResource StageTitleForegroundBrush}"
                               FontFamily="{DynamicResource StageFontFamily}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0" />

                    <!-- Tabs, instead of the title, when the Stage has more than one.
                         Click a tab to open it, double-click to rename it. The title's and
                         the tabs' left / centre / right position comes from Settings
                         (StageWindow.Appearance.vb). Full height, so the tab looks that
                         touch the bottom of the title bar can. -->
                    <ItemsControl x:Name="TabStrip"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  Margin="4,0"
                                  PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown">
                        <ItemsControl.ItemsPanel>
                            <!-- Side by side; shrinks the tabs fairly when they don't all fit (TabStripPanel.vb) -->
                            <ItemsPanelTemplate>
                                <local:TabStripPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- DynamicResource: the look changes when Settings does (StageWindow.Appearance.vb) -->
                                <Border Style="{DynamicResource StageTabHeaderStyle}">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource StageTitleForegroundBrush}"
                                               FontFamily="{DynamicResource StageFontFamily}"
                                               FontSize="{Binding FontSize, ElementName=TitleText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="160" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Shown in place of the title while renaming (Enter = keep, Esc = cancel) -->
                    <TextBox x:Name="TitleEditBox"
                             Style="{StaticResource StageTitleEditBoxStyle}"
                             Visibility="Collapsed"
                             KeyDown="TitleEditBox_KeyDown"
                             LostKeyboardFocus="TitleEditBox_LostKeyboardFocus" />
                </Grid>
            </Border>

            <!-- Details view column headings: click one to sort by it (again to reverse), drag
                 one left or right to move that column, right-click to show or hide columns
                 (StageWindow.DetailsColumns.vb). DetailsColumnsPanel lays them out exactly as
                 it lays out the columns of each row (StageDetailsTemplate in StagesStyles.xaml),
                 so headings and values always line up. -->
            <Border x:Name="DetailsHeader"
                    DockPanel.Dock="Top"
                    Visibility="Collapsed"
                    Margin="13,4,13,0"
                    BorderBrush="{StaticResource DetailsHeaderLineBrush}"
                    BorderThickness="0,0,0,1">
                <local:DetailsColumnsPanel x:Name="DetailsHeaderPanel"
                                           PreviewMouseLeftButtonDown="DetailsHeaderPanel_PreviewMouseLeftButtonDown"
                                           PreviewMouseMove="DetailsHeaderPanel_PreviewMouseMove"
                                           PreviewMouseLeftButtonUp="DetailsHeaderPanel_PreviewMouseLeftButtonUp"
                                           LostMouseCapture="DetailsHeaderPanel_LostMouseCapture">
                    <Button x:Name="DetailsNameHeader" local:DetailsColumnsPanel.Column="Name" Content="Name"
                            Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsNameHeader_Click" />
                    <Button x:Name="DetailsTypeHeader" local:DetailsColumnsPanel.Column="Type" Content="Type"
                            Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsTypeHeader_Click" />
                    <Button x:Name="DetailsDateHeader" local:DetailsColumnsPanel.Column="DateModified" Content="Date modified"
                            Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsDateHeader_Click" />
                    <!-- Sizes are right-aligned, as in Explorer, so the heading is too -->
                    <Button x:Name="DetailsSizeHeader" local:DetailsColumnsPanel.Column="Size" Content="Size"
                            HorizontalContentAlignment="Right"
                            Style="{StaticResource DetailsHeaderButtonStyle}" Click="DetailsSizeHeader_Click" />
                </local:DetailsColumnsPanel>
            </Border>

            <!-- The items (the last child, so they fill what's left), with a see-through layer
                 on top for the rubber-band selection -->
            <Grid>
                <ListBox x:Name="ItemsList"
                         Style="{StaticResource StageItemsListStyle}"
                         PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ItemsList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                         LostMouseCapture="ItemsList_LostMouseCapture"
                         KeyDown="ItemsList_KeyDown" />
                <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="SelectionBand"
                               Fill="{StaticResource SelectionBandFillBrush}"
                               Stroke="{StaticResource SelectionBandOutlineBrush}"
                               StrokeThickness="1"
                               Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </DockPanel>

        <!-- Outline round the whole Stage (Settings > Appearance > Border) -->
        <Border x:Name="StageOutline"
                BorderBrush="{DynamicResource StageBorderBrush}"
                BorderThickness="0"
                IsHitTestVisible="False" />

        <!-- Outlined tab look: the line that carries on from the open tab's outline round the
             rest of the Stage (shape worked out in StageWindow.TabFrame.vb). Ignores the mouse. -->
        <Path x:Name="TabFrameOutline"
              Stroke="{DynamicResource StageTabAccentBrush}"
              StrokeThickness="2"
              SnapsToDevicePixels="True"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
    </Grid>
</Window>
