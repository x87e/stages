<!--
  LightColors.xaml
  The light colours for the Settings window and the Rename / Title size dialogs.
  ThemeManager loads either this or DarkColors.xaml into the application's
  resources; both files must define exactly the same keys.
  Styles use these with {DynamicResource ...} so that switching theme repaints
  open windows immediately.
  Format: #RRGGBB.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Page background behind the cards -->
    <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#F9F9F9" />
    <!-- Left navigation column -->
    <SolidColorBrush x:Key="ThemeNavBackgroundBrush" Color="#F0F0F0" />
    <!-- Navigation entry under the mouse -->
    <SolidColorBrush x:Key="ThemeNavHoverBrush" Color="#E5E5E5" />
    <!-- Selected navigation entry -->
    <SolidColorBrush x:Key="ThemeNavSelectedBrush" Color="#E0E0E0" />
    <!-- Selected-page marker and keyboard-focus outline (Windows 11 default accent) -->
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#005FB8" />
    <!-- The boxes grouping related settings -->
    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#FFFFFF" />
    <!-- Outline of those boxes -->
    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#E5E5E5" />
    <!-- Line above the footer -->
    <SolidColorBrush x:Key="ThemeDividerBrush" Color="#E0E0E0" />
    <!-- Normal text -->
    <SolidColorBrush x:Key="ThemePrimaryTextBrush" Color="#1A1A1A" />
    <!-- Grey explanatory text -->
    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#5C5C5C" />
    <!-- Text of disabled buttons -->
    <SolidColorBrush x:Key="ThemeDisabledTextBrush" Color="#A0A0A0" />
    <!-- Text warning that something can't work -->
    <SolidColorBrush x:Key="ThemeWarningTextBrush" Color="#9D5D00" />
    <!-- Outline round colour swatches, so white/black swatches still show -->
    <SolidColorBrush x:Key="ThemeSwatchBorderBrush" Color="#8A8A8A" />
    <!-- Button, normal -->
    <SolidColorBrush x:Key="ThemeButtonBackgroundBrush" Color="#FDFDFD" />
    <!-- Button under the mouse -->
    <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#F3F3F3" />
    <!-- Button being pressed -->
    <SolidColorBrush x:Key="ThemeButtonPressedBrush" Color="#EBEBEB" />
    <!-- Button outline -->
    <SolidColorBrush x:Key="ThemeButtonBorderBrush" Color="#D0D0D0" />
    <!-- Text box background -->
    <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#FFFFFF" />
    <!-- Text box outline -->
    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#8A8A8A" />
    <!-- The draggable part of the scrollbar -->
    <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="#A0A0A0" />

</ResourceDictionary>
