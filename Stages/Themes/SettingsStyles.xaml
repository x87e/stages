<!--
  SettingsStyles.xaml
  Styles for the Settings window and the Rename / Title size dialogs (Stage
  windows use StagesStyles.xaml). A Windows 11-like look: a navigation column
  on the left and "cards" grouping the settings on the right.

  No colours are defined here. Every colour is a {DynamicResource Theme...Brush}
  from LightColors.xaml or DarkColors.xaml, whichever ThemeManager has loaded,
  so switching Settings > Appearance > Theme repaints open windows at once.
  (DynamicResource = "look the key up again whenever it changes";
   StaticResource = "look it up once"; StaticResource is still used below to
   refer to styles defined in this same file, which never change.)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Text ===== -->
    <!-- Big heading at the top of each page, e.g. "Appearance" -->
    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Heading of one card, e.g. "Default background" -->
    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Grey explanatory text under a heading or control -->
    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Warning text for things that stop a setting working (e.g. transparency effects off) -->
    <Style x:Key="SettingsWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsDescriptionStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeWarningTextBrush}" />
    </Style>

    <!-- Label at the left of a setting row ("Colour", "Strength"...) -->
    <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
    </Style>

    <!-- Current value at the right of a slider row ("39%", "35px") -->
    <Style x:Key="SettingsRowValueStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
    </Style>

    <!-- ===== Containers ===== -->
    <!-- A rounded box grouping related settings -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- One row inside a card: label | control | value -->
    <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!-- ===== Controls ===== -->
    <!-- Buttons get their own template: WPF's built-in one is always light grey,
         which is unreadable with light text on a dark page. -->
    <Style x:Key="SettingsButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- The focus outline is drawn by the IsKeyboardFocused trigger instead of WPF's dotted box -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <!-- RecognizesAccessKey: "_" in a caption underlines the Alt shortcut letter -->
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                        </Trigger>
                        <!-- IsDefault = the button Enter presses (OK in dialogs): accent outline -->
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ThemeDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text boxes (Rename dialog) -->
    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
        <!-- The blinking text cursor, which would otherwise stay black on a dark box -->
        <Setter Property="CaretBrush" Value="{DynamicResource ThemePrimaryTextBrush}" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
    </Style>

    <Style x:Key="SettingsSliderStyle" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <!-- The coloured square inside a "pick colour" button -->
    <Style x:Key="SettingsColorSwatchStyle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeSwatchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ===== Slim scrollbar for the page area (WPF's default one is always light) ===== -->
    <Style x:Key="SettingsScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ThemeScrollThumbBrush}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A 6px wide vertical scrollbar with no arrow buttons -->
    <Style x:Key="SettingsScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Margin" Value="0,4,3,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- IsDirectionReversed: vertical tracks count from the top -->
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource SettingsScrollBarThumbStyle}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Left navigation column ===== -->
    <Style x:Key="SettingsNavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- One page name in the navigation column; an accent bar marks the selected page -->
    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavItemBorder" Background="Transparent" CornerRadius="4" Padding="14,8">
                        <Grid>
                            <!-- The selected-page marker, hidden until selected -->
                            <Border x:Name="SelectedMarker"
                                    Width="3" Height="16"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    Margin="-10,0,0,0"
                                    Background="{DynamicResource ThemeAccentBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavItemBorder" Property="Background" Value="{DynamicResource ThemeNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavItemBorder" Property="Background" Value="{DynamicResource ThemeNavSelectedBrush}" />
                            <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
