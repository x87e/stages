<!--
  DarkColors.xaml
  The dark colours for the Settings window and the Rename / Title size dialogs.
  ThemeManager loads either this or LightColors.xaml into the application's
  resources; both files must define exactly the same keys.
  Styles use these with {DynamicResource ...} so that switching theme repaints
  open windows immediately.
  Values follow Windows 11's dark Settings app.
  Format: #RRGGBB.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Page background behind the cards -->
    <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="#202020" />
    <!-- Left navigation column -->
    <SolidColorBrush x:Key="ThemeNavBackgroundBrush" Color="#1C1C1C" />
    <!-- Navigation entry under the mouse -->
    <SolidColorBrush x:Key="ThemeNavHoverBrush" Color="#2D2D2D" />
    <!-- Selected navigation entry -->
    <SolidColorBrush x:Key="ThemeNavSelectedBrush" Color="#333333" />
    <!-- Selected-page marker and keyboard-focus outline (Windows 11 default accent) -->
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#60CDFF" />
    <!-- The boxes grouping related settings -->
    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#2B2B2B" />
    <!-- Outline of those boxes -->
    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#3A3A3A" />
    <!-- Line above the footer -->
    <SolidColorBrush x:Key="ThemeDividerBrush" Color="#3A3A3A" />
    <!-- Normal text -->
    <SolidColorBrush x:Key="ThemePrimaryTextBrush" Color="#FFFFFF" />
    <!-- Grey explanatory text -->
    <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#C5C5C5" />
    <!-- Text of disabled buttons -->
    <SolidColorBrush x:Key="ThemeDisabledTextBrush" Color="#7A7A7A" />
    <!-- Text warning that something can't work -->
    <SolidColorBrush x:Key="ThemeWarningTextBrush" Color="#FCE100" />
    <!-- Outline round colour swatches, so white/black swatches still show -->
    <SolidColorBrush x:Key="ThemeSwatchBorderBrush" Color="#9A9A9A" />
    <!-- Button, normal -->
    <SolidColorBrush x:Key="ThemeButtonBackgroundBrush" Color="#2D2D2D" />
    <!-- Button under the mouse -->
    <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#373737" />
    <!-- Button being pressed -->
    <SolidColorBrush x:Key="ThemeButtonPressedBrush" Color="#272727" />
    <!-- Button outline -->
    <SolidColorBrush x:Key="ThemeButtonBorderBrush" Color="#454545" />
    <!-- Text box background -->
    <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#2D2D2D" />
    <!-- Text box outline -->
    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#6A6A6A" />
    <!-- The draggable part of the scrollbar -->
    <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="#6E6E6E" />

</ResourceDictionary>
